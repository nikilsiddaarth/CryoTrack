# CryoTrack — Pharmaceutical Cold-Chain Intelligence Platform
# Environment Configuration Template (Copy to .env and supply real secrets)

# Oracle Database Connection
ORACLE_USER=COLDCHAIN
ORACLE_PASSWORD=COLDCHAINPHARM
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=XEPDB1

# Flask Application & Session Security
SECRET_KEY=replace-with-a-64-char-cryptographic-random-hex-key
FLASK_PORT=5000
FLASK_DEBUG=False
SESSION_COOKIE_SECURE=False

# Optional First-Run Bootstrap Administrator (alternatively run: python create_user.py)
# CRYOTRACK_ADMIN_EMAIL=admin@cryotrack.io
# CRYOTRACK_ADMIN_PASSWORD=SetStrongPasswordHere
# CRYOTRACK_ADMIN_NAME=Operations Administrator

# Optional Google OAuth 2.0 / OpenID Connect Configuration
# Create OAuth 2.0 Web Client credentials in Google Cloud Console and add the callback URI below:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
